	pipe.Del(Ctx, toDelete...)
	pipe.SRem(Ctx, indexKey, toRemove...)
	if _, err := pipe.Exec(Ctx); err != nil {
		slog.Error("Failed to execute InvalidateOtherUserSessions pipeline", "error", err)
	}
}
